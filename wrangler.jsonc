{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kinexis-digital",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "workers_dev": true,
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "kinexis-digital"
    }
  ],
  // Custom domains (enable once the zone is attached to this account):
  "routes": [
    { "pattern": "kinexisdigital.com", "custom_domain": true },
    { "pattern": "www.kinexisdigital.com", "custom_domain": true }
  ]
}
