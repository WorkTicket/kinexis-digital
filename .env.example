# Public site URL (no trailing slash)
NEXT_PUBLIC_SITE_URL=https://www.kinexisdigital.com

# Google Search Console URL-prefix verification token (optional).
# Next inlines this at build time. Put it in .env.local and in the Workers
# build environment. Leave it blank when a DNS TXT record verifies the domain.
NEXT_PUBLIC_GSC_VERIFICATION=

# Set to 0 to deploy without the live Search Console check and IndexNow ping.
# SEARCH_NOTIFY=0

# Google Analytics 4 measurement ID (optional)
NEXT_PUBLIC_GA_ID=

# Optional homepage / video-review embed (YouTube, Vimeo, or similar).
NEXT_PUBLIC_VIDEO_URL=

# Form delivery. Set Mailgun, or set FORM_ENDPOINT to forward submissions.
# Put these in .env.local for `next dev`, and in Wrangler secrets for production.
# MAILGUN_API_KEY=
# MAILGUN_DOMAIN=kinexisdigital.com
# MAILGUN_FROM=Kinexis Digital <hello@kinexisdigital.com>
# MAILGUN_REGION=us
# Separate multiple recipients with commas.
# CONTACT_TO=hello@kinexisdigital.com,coltonwehr@kinexisdigital.com,coltondwehr@icloud.com
# FORM_ENDPOINT=
# Or use Gmail SMTP with an app password (supported by the production Worker).
# GMAIL_USER=
# GMAIL_APP_PASSWORD=
# CONTACT_TO_EMAIL=hello@kinexisdigital.com

# PayPal. Plan checkout works with the public client id already used on the live site.
# Invoice and deposit payments need the REST app secret (Wrangler secret or .env.local).
# NEXT_PUBLIC_PAYPAL_CLIENT_ID=
# NEXT_PUBLIC_PAYPAL_WEBSITE_PLAN_ID=
# NEXT_PUBLIC_PAYPAL_LEAD_SYSTEM_PLAN_ID=
# NEXT_PUBLIC_PAYPAL_PLUS_PLAN_ID=
# PAYPAL_CLIENT_ID=
# PAYPAL_CLIENT_SECRET=
# PAYPAL_API_BASE=https://api-m.paypal.com

# Facebook Page recommendations on /reviews. Without this, the site shows the
# recommendations already published on the page. With a Page access token that
# has pages_read_user_content, new recommendations replace that list about hourly.
# Also set this as a Wrangler secret for production.
# FACEBOOK_PAGE_ACCESS_TOKEN=

# Trustpilot: the free Review Collector widget is hardcoded (business unit
# 6aef824c0156593a34415361). Optional API key syncs review text into our own
# cards — display TrustBoxes need a paid Trustpilot plan.
# TRUSTPILOT_API_KEY=
# TRUSTPILOT_BUSINESS_UNIT_ID=

# On-site reviews use the REVIEWS KV binding in wrangler.jsonc (no secret).
