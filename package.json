{
  "name": "kinexis-digital",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@11.12.1",
  "engines": {
    "node": ">=22.0.0 <25",
    "npm": ">=11.0.0"
  },
  "browserslist": [
    "chrome >= 111",
    "edge >= 111",
    "firefox >= 111",
    "safari >= 16.4"
  ],
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/build.mjs",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "check": "npm run lint && npm run typecheck && npm run check:contact && npm run check:attachment-security && npm run check:rate-limit && npm run check:reviews && npm run check:spanish-mirror && npm run check:commercial && npm run check:conferbot",
    "images:optimize": "node scripts/optimize-content-images.mjs",
    "images:heroes": "node scripts/optimize-hero-images.mjs",
    "images:og": "node scripts/generate-og-images.mjs",
    "images:portfolio-cards": "node scripts/generate-portfolio-cards.mjs",
    "images:posters": "node scripts/optimize-video-posters.mjs",
    "check:contact": "node scripts/check-contact-delivery.mjs",
    "check:attachment-security": "node scripts/check-attachment-security.mjs",
    "check:rate-limit": "node scripts/check-rate-limit.mjs",
    "check:reviews": "node scripts/check-reviews-routes.mjs",
    "check:spanish-mirror": "node scripts/check-spanish-mirror.mjs",
    "check:commercial": "node scripts/check-commercial-consistency.mjs",
    "check:conferbot": "node scripts/check-conferbot-webhook.mjs && node scripts/check-conferbot-widget.mjs",
    "smoke": "node scripts/smoke-routes.mjs",
    "check:payment-reconciliation": "node scripts/check-payment-reconciliation.mjs",
    "reconcile:invoices": "node scripts/reconcile-invoice-ledger.mjs",
    "backup:d1-invoice": "node scripts/d1-backup-invoice-ledger.mjs",
    "check:invoice-security": "node scripts/check-invoice-security.mjs && node scripts/check-payment-integrity.mjs && node scripts/check-paypal-order-service.mjs && node scripts/check-invoice-ledger.mjs && node scripts/check-invoice-routes.mjs && node scripts/check-invoice-import.mjs && node scripts/check-payment-reconciliation.mjs",
    "check:route-integration": "npm run check:contact && npm run check:reviews && npm run check:invoice-security && npm run check:conferbot",
    "check:structured-data": "node scripts/check-structured-data.mjs",
    "check:paypal-sandbox": "node scripts/check-paypal-sandbox.mjs",
    "test:e2e": "playwright test",
    "lighthouse:budget": "node scripts/lighthouse-budget.mjs",
    "lighthouse:budget:mobile": "node scripts/lighthouse-budget.mjs --form-factor=mobile",
    "lighthouse:budget:desktop": "node scripts/lighthouse-budget.mjs --form-factor=desktop",
    "verify": "npm run check && npm run check:invoice-security && npm run check:paypal-sandbox && npm run test:e2e",
    "verify:prod": "node scripts/smoke-routes.mjs https://www.kinexisdigital.com && node scripts/check-structured-data.mjs https://www.kinexisdigital.com && node scripts/lighthouse-budget.mjs https://www.kinexisdigital.com --form-factor=both",
    "build:worker": "node scripts/search-on-deploy.mjs --preflight && opennextjs-cloudflare build && node scripts/defer-chunks.mjs --opennext-cache",
    "preview": "npm run build:worker && opennextjs-cloudflare preview",
    "deploy:worker": "opennextjs-cloudflare deploy",
    "deploy:preview": "node scripts/deploy-preview.mjs",
    "deploy": "node scripts/deploy-production.mjs",
    "search:notify": "node scripts/search-on-deploy.mjs",
    "upload": "npm run check && npm run build:worker && opennextjs-cloudflare upload",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.10.0",
    "next": "^16.4.2",
    "nodemailer": "^10.2.1",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.13",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24.19.2",
    "@types/nodemailer": "^8.0.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "chrome-launcher": "^1.2.2",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.2",
    "lighthouse": "^13.6.0",
    "postcss": "^8.5.32",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "wrangler": "^4.154.0"
  },
  "overrides": {
    "@node-minify/core": {
      "glob": "^10.5.0"
    }
  }
}
