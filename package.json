{
  "name": "kinexis-digital",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@11.12.1",
  "engines": {
    "node": ">=22.0.0 <25",
    "npm": ">=11.0.0"
  },
  "browserslist": [
    "chrome >= 111",
    "edge >= 111",
    "firefox >= 111",
    "safari >= 16.4"
  ],
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/build.mjs",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "check": "npm run lint && npm run typecheck && npm run check:contact",
    "images:optimize": "node scripts/optimize-content-images.mjs",
    "images:heroes": "node scripts/optimize-hero-images.mjs",
    "images:posters": "node scripts/optimize-video-posters.mjs",
    "check:contact": "node scripts/check-contact-delivery.mjs",
    "build:worker": "node scripts/search-on-deploy.mjs --preflight && opennextjs-cloudflare build && node scripts/defer-chunks.mjs --opennext-cache",
    "preview": "npm run build:worker && opennextjs-cloudflare preview",
    "deploy:worker": "opennextjs-cloudflare deploy",
    "deploy": "npm run check && npm run build:worker && npm run deploy:worker && npm run search:notify",
    "search:notify": "node scripts/search-on-deploy.mjs",
    "upload": "npm run check && npm run build:worker && opennextjs-cloudflare upload",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.10.0",
    "next": "^16.4.2",
    "nodemailer": "^10.2.1",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.13",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24.19.2",
    "@types/nodemailer": "^8.0.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "chrome-launcher": "^1.2.2",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.2",
    "lighthouse": "^13.6.0",
    "postcss": "^8.5.32",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "wrangler": "^4.154.0"
  },
  "overrides": {
    "@node-minify/core": {
      "glob": "^10.5.0"
    }
  }
}
