        "mainEntity": [
          {
            "@type": "Question",
            "name": "Is there a minimum term?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "3-month minimum from launch, then month-to-month. Cancel anytime after that by text, email or Messenger."
            }
          },
          {
            "@type": "Question",
            "name": "How do I cancel?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "After the 3-month minimum, by text, email or Messenger. No call or form needed. Billing stops at the end of the month you've paid for. Cancelling inside PayPal alone doesn't end the minimum. See Terms §7."
            }
          },
          {
            "@type": "Question",
            "name": "How does the guarantee work?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Lead System and Plus: zero tracked leads in your first 60 days live means your 3rd and 4th monthly charges are waived and the minimum is dropped. Once per business. See Terms §10.2."
            }
          },
          {
            "@type": "Question",
            "name": "When am I charged?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Subscribe on your launch day, after you approve your site. Your first charge happens when you subscribe. Subsequent charges follow your PayPal billing schedule. Own It: when you pay."
            }
          },
          {
            "@type": "Question",
            "name": "Taxes?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Prices don't include sales tax, if any applies."
