    "structuredData": [
      {
        "@context": "https://schema.org",
        "@type": "FAQPage",
        "mainEntity": [
          {
            "@type": "Question",
            "name": "How much does a website cost?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Basic websites start at $500 and stop at four pages: Home, About, Services, and Contact. Custom websites start at $2,000. The page count is set on the call. Custom covers 5 pages or more. A 15-page site with writing on each page costs more. Booking, payments, and client portals are quoted only if the project needs them."
            }
          },
          {
            "@type": "Question",
            "name": "How soon will I hear back?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Within 1 business day (Mon–Fri, 9 AM–6 PM ET). We'll call from +1 (307) 500-3371, look at your current site or notes, and tell you what a rebuild should fix first."
            }
          },
          {
            "@type": "Question",
            "name": "Is this a WordPress template?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "No. Basic starts from a proven layout we already coded, then we fit your logo, colors, and services onto it. It is custom coded, not a WordPress theme, and not a page builder. Custom is designed and coded around your business."
            }
          },
          {
            "@type": "Question",
            "name": "Will I own my website?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Yes. You own the finished site, its content, and its code once the final payment clears. It's deployed on Cloudflare, and we'll move it to your own Cloudflare account whenever you ask. The domain stays in your name."
            }
          },
          {
            "@type": "Question",
            "name": "Is hosting included?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Hosting is typically $0/month on Cloudflare's free plan; you only pay for your domain (about $10–20/year). The site runs on Cloudflare Pages. Managed care is optional, and the monthly rate is in the proposal. It covers monitoring and fixes. The domain stays in your name. If you want to run it yourself, we'll move the site to your own Cloudflare account."
            }
          },
          {
            "@type": "Question",
            "name": "Is SEO included?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Basic covers titles, descriptions, and indexing on a site of up to 4 pages. Custom adds a fuller setup where the project needs it: a page for each service, titles and descriptions, local structure, a sitemap, and indexing. Rankings, Google Business Profile, and monthly SEO stay optional after launch."
            }
          },
          {
            "@type": "Question",
            "name": "Can you redesign my existing website?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Yes. That's most of the work on this page. If the business has outgrown the current site, that's the starting point."
            }
          },
          {
            "@type": "Question",
            "name": "How long does a project take?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Most sites go live in 2 to 6 weeks. That depends on how quickly photos and feedback come back."
            }
          },
          {
            "@type": "Question",
            "name": "Do I need monthly maintenance?",
            "acceptedAnswer": {
              "@type": "Answer",
